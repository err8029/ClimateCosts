# Copia este archivo a secrets.toml (misma carpeta) y rellena tus propios valores -
# secrets.toml NO se versiona (ver .gitignore), así que las credenciales nunca llegan a git.
# Genera el hash/salt con: python generar_credenciales.py
[auth]
username = "tu_usuario"
password_hash = "hash PBKDF2-SHA256 (hex) de tu contraseña"
password_salt = "salt aleatorio (hex)"
